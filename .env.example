# ------------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. Never commit real credentials.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Required runtime variables
#
# Needed for the application to talk to Supabase. `NEXT_PUBLIC_` variables are
# inlined into the browser bundle, so only non-secret values may use that prefix.
# The anon key is safe to expose because access is constrained by Row Level
# Security; the service role key is not.
# ------------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# Server-only secrets
#
# Bypasses Row Level Security. Used only by trusted server-side workflows.
# Must never be prefixed with NEXT_PUBLIC_ or read from client code.
# ------------------------------------------------------------------------------

SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# AI Router configuration
#
# Optional. The AI backend is a configurable, OpenAI-compatible AI Router: the
# application targets the OpenAI API contract, not any one vendor. Point the base
# URL at whichever compatible endpoint you run — a custom router, a self-hosted
# gateway, a local server, or a hosted provider — without changing application code.
#
# Both values are server-only. Never give them a NEXT_PUBLIC_ prefix.
# The application starts and builds without them; only AI calls fail if unset.
#
# AI_ROUTER_BASE_URL — OpenAI-compatible endpoint, e.g. ending in /v1
# AI_ROUTER_API_KEY  — credential for that endpoint
# ------------------------------------------------------------------------------

# AI_ROUTER_BASE_URL=https://your-ai-router.example/v1
# AI_ROUTER_API_KEY=your-ai-router-api-key
