# Dependencies
node_modules/

# Next.js build output
.next/
out/

# TypeScript incremental build metadata
*.tsbuildinfo

# Production build artifacts
dist/
build/

# Environment files — never commit real secrets.
# .env.example is intentionally NOT ignored: it holds placeholders only.
.env
.env.local
.env.*.local

# Test / coverage output
coverage/

# Supabase CLI local state — regenerated by `supabase link`, machine-specific.
supabase/.temp/

# Logs
*.log
npm-debug.log*

# OS / editor noise
.DS_Store
.idea/
.vscode/

# Throwaway verification scripts (live DB probes run inside a rolled-back
# transaction). Kept out of the repository: they are evidence for one change,
# not maintained code, and they name real workspace ids.
.p6-shots/
.vercel
.env*
